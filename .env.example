# OpenRouter API key used for all models by default (attacker, target, evaluator, judge).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API key (optional). When set, `openai/*` and `gpt-*`/`o*` model ids
# are sent to the OpenAI API directly instead of through OpenRouter.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: an OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, Azure, a
# gateway...). Same as --base-url. With no OpenRouter key, every model goes
# here; with one, only OpenAI-style and `openai/`-prefixed ids do. Local
# servers don't need OPENAI_API_KEY.
# OPENAI_BASE_URL=http://localhost:11434/v1
