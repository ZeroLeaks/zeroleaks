# OpenRouter API key used for all models by default (attacker, target, evaluator, judge).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API key (optional). When set, `openai/*` and `gpt-*`/`o*` model ids
# are sent to the OpenAI API directly instead of through OpenRouter.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: point the OpenAI provider at an OpenAI-compatible endpoint
# (Azure, a gateway, local server...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Requesty API key (optional). Only used when you opt in with
# `--provider requesty` / ZEROLEAKS_PROVIDER=requesty or a `requesty/` model id
# prefix. Keys: https://app.requesty.ai/api-keys
# REQUESTY_API_KEY=your_requesty_api_key_here
# ZEROLEAKS_PROVIDER=requesty
